# Database Connection URL (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# For Render / Neon / Supabase: postgresql://postgres:password@ep-xyz.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smritisetu

# Server Port (default: 8000)
PORT=8000

# Allowed CORS Origins (comma-separated or wildcard)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://peppy-puppy-9df68c.netlify.app
